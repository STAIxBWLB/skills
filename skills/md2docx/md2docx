#!/bin/bash
# md2docx skill wrapper — markdown → refined .docx via docx-js (docx npm).
#
# Usage:
#   ./md2docx <file.md> [more.md ...]
#   ./md2docx <file.md> -o <out.docx>
#   ./md2docx <file.md> --theme mineral|koica|mono   (default: mineral)
#   ./md2docx <file.md> --serif                       (Korean myeongjo body, formal)
#   ./md2docx <file.md> --gaejosik                     (Korean official symbol ladder)
#   ./md2docx <file.md> --header "Running header"      (override) | --no-header
#
# Resolves the Maru env Node runtime + sets NODE_PATH so the bundled `docx`
# package (<env>/node_modules) is importable. See envs/default/REFERENCE.md.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# Resolve the Maru skills Node interpreter, most-specific first.
# Honors $SKILL_NODE, then host-injected $MARU_SKILLS_ENV, then Maru's active hashed
# env (or, when there is none, the legacy ~/.maru/env), then a repo-local walk-up
# (dev-in-tree), then system node.
# Maru's active hashed env, as Maru's env_root() picks it: ~/.maru/env/<active.envHash>
# from bundle-state.json when that directory exists, built or not. Prints nothing
# (no state file, no active hash, a name Maru rejects, no directory) to fall through.
maru_active_env() {
    local f="$HOME/.maru/skills/bundle-state.json" h
    [ -f "$f" ] && [ -r "$f" ] && [ ! -L "$f" ] || return 1
    h="$(tr -d '\n' < "$f" \
        | sed -n 's/.*"active"[[:space:]]*:[[:space:]]*{[^}]*"envHash"[[:space:]]*:[[:space:]]*"\([a-z0-9_-]*\)".*/\1/p')"
    case "$h" in ''|node|node_modules|temp|logs|input|output) return 1 ;; esac
    [ -d "$HOME/.maru/env/$h" ] && [ ! -L "$HOME/.maru/env/$h" ] && printf '%s\n' "$HOME/.maru/env/$h"
}

find_env_node() {
    local c dir active
    active="$(maru_active_env || true)"
    if [ -n "${SKILL_NODE:-}" ] && [ -x "${SKILL_NODE}" ]; then
        printf '%s\n' "$SKILL_NODE"; return 0
    fi
    for c in \
        "${MARU_SKILLS_ENV:+$MARU_SKILLS_ENV/node/bin/node}" \
        "${active:-$HOME/.maru/env}/node/bin/node"; do
        [ -n "$c" ] && [ -x "$c" ] && printf '%s\n' "$c" && return 0
    done
    dir="$SCRIPT_DIR"
    while [ "$dir" != "/" ]; do
        [ "$dir" -ef "$HOME/.maru" ] && break  # ~/.maru/env is the legacy env: never via the walk-up
        for c in \
            "$dir/env/node/bin/node" \
            "$dir/envs/default/node/bin/node" \
            "$dir/skills/envs/default/node/bin/node"; do
            [ -x "$c" ] && printf '%s\n' "$c" && return 0
        done
        dir="$(dirname "$dir")"
    done
    command -v node 2>/dev/null && return 0
    return 1
}

NODE_BIN="$(find_env_node || true)"
if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
    echo "[md2docx] node 없음: Maru env node도 system node도 찾지 못함. Maru 설정 > Skills > Bootstrap 실행 (Maru 앱도 활성 해시 env도 없을 때만: 번들 또는 checkout의 envs/default/setup.sh --target ~/.maru/env)" >&2
    exit 1
fi

# Resolve the env root from the bundled node (.../node/bin/node → env root) and
# export NODE_PATH so CJS `require("docx")` resolves the env-installed package.
# (ESM static import does NOT honor NODE_PATH; the converter uses createRequire.)
case "$NODE_BIN" in
    */node/bin/node)
        _ENV_ROOT="$(cd "$(dirname "$NODE_BIN")/../.." && pwd -P)"
        ;;
    *)
        _ENV_ROOT="${MARU_SKILLS_ENV:-$(maru_active_env || true)}"
        _ENV_ROOT="${_ENV_ROOT:-$HOME/.maru/env}"
        echo "[md2docx] 번들 node 미발견, system node fallback: $NODE_BIN (번들 node 복구: Maru 설정 > Skills > Bootstrap, Maru 앱도 활성 해시 env도 없을 때만: 번들 또는 checkout의 envs/default/setup.sh --target ~/.maru/env)" >&2
        ;;
esac
if [ -d "$_ENV_ROOT/node_modules" ]; then
    case ":${NODE_PATH:-}:" in
        *":$_ENV_ROOT/node_modules:"*) ;;
        *) NODE_PATH="$_ENV_ROOT/node_modules${NODE_PATH:+:$NODE_PATH}"; export NODE_PATH;;
    esac
fi

if [ $# -eq 0 ]; then
    cat <<USAGE
md2docx — markdown → refined .docx (docx-js, pandoc 미사용)

Usage: ./md2docx <file.md> [more.md ...] [options]

Options:
  -o <out.docx>           단일 입력일 때 출력 경로 지정 (기본: 입력 .md 옆에 .docx)
  --theme mineral|koica|mono   팔레트 (기본 mineral; koica=네이비, mono=모노크롬)
  --serif                 한글 명조 본문 (격식 문서)
  --gaejosik              개조식 기호 사다리 (□/○ 내어쓰기, 불릿 -/·)
  --header "TEXT"         머리말 텍스트 override
  --no-header             머리말 제거

Features: YAML frontmatter, H1–H6(+부제), **bold**/_italic_/\`code\`/〔확인필요〕,
  링크, 표(정렬·라벨셀·zebra), 중첩 불릿/번호, 체크리스트, 인용, 코드블록, 구분선.
  폰트: 맑은 고딕(eastAsia) + Calibri/Cambria. 머리말=제목, 바닥글=PAGE.

런타임: Maru env 번들 Node + docx npm (NODE_PATH=<env>/node_modules, env 해소 순서는 envs/default/REFERENCE.md).
경로 기준: ~/.maru/skills/md2docx/md2docx
USAGE
    exit 0
fi

exec "$NODE_BIN" "$SCRIPT_DIR/scripts/md2docx.mjs" "$@"
